            },
            ".text-box": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "justify-content": "center",
              "padding": "20px",
              "min-height": "480px",
              "margin": "0 auto",
              "background-color": "@contentColor",
              "@media (max-width: 991px)": {
                "min-height": "400px",
                "padding": "50px 20px"
              },
              "@media (max-width: 767px)": {
                "padding": "50px 10px"
              }
            },
            ".mbr-section-title": {
              "color": "#131313"
            },
            ".mbr-section-subtitle": {
              "margin-top": "20px",
              "color": "#131313"
            },
            ".mbr-text": {
              "margin-top": "44px",
              "color": "#131313",
              "@media (max-width: 767px)": {
                "margin-top": "20px"
