              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "padding": "0 !important",
              "& when (@reverseContent)": {
                "right": "auto",
                "left": "0"
              },
              "img": {
                "height": "100%",
                "width": "100%",
                "object-fit": "cover"
              },
              "@media (max-width: 1199px)": {
