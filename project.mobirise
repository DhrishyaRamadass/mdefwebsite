          "_name": "amenu1",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1 calmm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3.6\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#131313\" condition=\"showBorder\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#131313\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://mobiri.se\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logomdefweb-160x226.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"></a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-7\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">DHRISH HOME </a>\n                    </li>\n                    <li class=\"nav-item\"><a class=\"nav-link link show text-black\" href=\"about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ABOUT</a>\n                    </li>\n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">MDEF01</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-268\"><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Term 1</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-549\"><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Pre-Courses</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-792\"><a class=\"dropdown-item text-black\" href=\"digitalfabrication.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Digital Fabrication</a><a class=\"dropdown-item text-black\" href=\"rhinoceros.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Rhinoceros</a><a class=\"dropdown-item text-black\" href=\"inputsandotputs.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Arduino and Python</a></div></div><a class=\"dropdown-item text-black\" href=\"landing.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Landing</a><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Design Studio 1</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-513\"><a class=\"dropdown-item text-black text-primary\" href=\"ds1class1.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Class 1</a><a class=\"dropdown-item text-black\" href=\"ds1intervention1.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 1</a><a class=\"dropdown-item text-black\" href=\"ds1class2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Class 2</a><a class=\"dropdown-item text-black\" href=\"ds2intervention2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 2</a><a class=\"dropdown-item text-black\" href=\"designspaces.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design Spaces</a></div></div><a class=\"dropdown-item text-black\" href=\"aows.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Atlas of Weak Signals</a><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">The Machine Paradox</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-342\"><a class=\"dropdown-item text-black\" href=\"machineparadox.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reflections</a><a class=\"dropdown-item text-black\" href=\"forensicreport.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Forensic Report</a><a class=\"dropdown-item text-black\" href=\"LifeX.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LifeX Project</a></div></div><a class=\"dropdown-item text-black\" href=\"livingwithyourideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Living with your Ideas</a><a class=\"dropdown-item text-black\" href=\"page25.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Documenting Design</a><a class=\"dropdown-item text-black\" href=\"biozero.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Biology Zero</a><a class=\"dropdown-item text-black\" href=\"agrizero.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Agriculture Zero</a><a class=\"dropdown-item text-black\" href=\"designwithothers.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design with Others</a><a class=\"dropdown-item text-black\" href=\"extendedintelligences.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design with Extended Intelligence</a><a class=\"dropdown-item text-black\" href=\"designdialogues.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design Dialogues 1</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Term 2</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-228\"><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Design Studio 2<br></a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-770\"><a class=\"show dropdown-item text-black text-primary\" href=\"intervention1ds2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 1</a><a class=\"show dropdown-item text-black text-primary\" href=\"intervention2ds2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 2</a><a class=\"show dropdown-item text-black text-primary\" href=\"ds2reviews.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reviews</a><a class=\"show dropdown-item text-black text-primary\" href=\"ds2reflections.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reflection</a></div></div><a class=\"dropdown-item text-black text-primary show\" href=\"climateemergency.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Designing in a State of Climate Emergency</a><a class=\"dropdown-item text-black text-primary show\" href=\"futuretalksdd.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Future Talks: Distributed Design</a><a class=\"show dropdown-item text-black\" href=\"fairfutures.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Fair Futures</a><a class=\"show dropdown-item text-black text-primary\" href=\"measuringtheworld.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Measuring the World</a><a class=\"show dropdown-item text-black\" href=\"extendedintelligences2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Extended Intelligences</a><a class=\"show dropdown-item text-black text-primary\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Communicating Ideas<br></a><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"digitalprototypingfordesign.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Digital Prototyping for Design</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-475\"><a class=\"show dropdown-item text-black text-primary\" href=\"biomaterials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">1: Biomaterials</a><a class=\"show dropdown-item text-black text-primary\" href=\"growingmaterials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">2: Growing and Extruding</a><a class=\"show dropdown-item text-black text-primary\" href=\"cncdpd.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">3: CNC</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Microchallenge</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-720\"><a class=\"show dropdown-item text-black text-primary\" href=\"microchallenge1.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">1</a><a class=\"show dropdown-item text-black text-primary\" href=\"microchallenge2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">2</a></div></div><a class=\"dropdown-item text-black text-primary show\" href=\"angoustrine.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Research Trip</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item text-black dropdown-toggle\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Term 3</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-308\"><div class=\"dropdown\"><a class=\"dropdown-item text-black dropdown-toggle\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Design Studio 3</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-819\"><a class=\"show dropdown-item text-black text-primary\" href=\"ds3intro.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Class 1</a></div></div><a class=\"show dropdown-item text-black text-primary\" href=\"atlasofweaksignals2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Atlas of Weak Signals: Update</a><div class=\"dropdown\"><a class=\"dropdown-item text-black dropdown-toggle\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Future Talks</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-527\"><a class=\"show dropdown-item text-black text-primary\" href=\"saulbaeza.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Saul Baeza</a><a class=\"dropdown-item text-black\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">New Item</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item text-black dropdown-toggle\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Digital Prototyping for Design</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-101\"><a class=\"dropdown-item text-black show text-primary\" href=\"velostatsensor.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">4: Body and Sensors</a><a class=\"dropdown-item text-black show text-primary\" href=\"wekinator.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">5: AI and Visuals</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item text-black dropdown-toggle\" href=\"term3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Microchallenge</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-544\"><a class=\"dropdown-item text-black show text-primary\" href=\"microchallenge3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">3</a></div></div><a class=\"dropdown-item text-black text-primary\" href=\"communicatingideas3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Communicating Ideas</a><a class=\"dropdown-item text-black text-primary\" href=\"communicatingideas3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design Ethics</a><a class=\"dropdown-item text-black text-primary\" href=\"communicatingideas3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Critical Transfeminist Design<br></a></div></div><a class=\"show dropdown-item text-black text-primary\" href=\"https://seenunseen.mobirisesite.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">End of Year Project<br></a></div>\n                    </li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-black dropdown-toggle show\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">MDEF02</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-186\" data-bs-popper=\"none\"><a class=\"text-black show dropdown-item text-primary\" href=\"businessinnovation.html#aheader3-ad\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Business Innovation<br></a><a class=\"text-black show dropdown-item text-primary\" href=\"page64.html#aheader2-ak\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LLUM</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-black show text-primary\" href=\"mastersproject.html#top\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Masters Project</a></li></ul>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-white\" href=\"mdefmenu.html\" data-app-placeholder=\"Type Text\">MDEF</a></div>\n            </div>\n            <div class=\"border-item\"></div>\n        </div>\n    </nav>\n</section>",
