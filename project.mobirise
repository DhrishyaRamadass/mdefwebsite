                "bottom": "0",
                "margin-top": "auto",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "top": "100%",
                  "left": "50%",
                  "transform": "translate(-50%, 0)",
                  "width": "100vw",
                  "height": "100vw",
                  "background": "@menuBgColor",
                  "z-index": "4",
                  "transition": "0.1s all"
                }
              }
            },
            "@media (max-width: 991px)": {
