            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              }
            },
            ".navbar-caption": {},
            ".navbar-nav": {
              "margin": "0 auto"
            },
            ".dropdown-menu, .navbar.opened": {
