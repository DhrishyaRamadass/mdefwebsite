              "padding": "10px 25px",
              "min-height": "48px"
            },
            ".border-item": {
              "position": "absolute",
              "bottom": "-1px",
              "display": "none",
              "width": "100%",
              "background-color": "transparent",
              "& when (@showBorder)": {
                "height": "2px",
                "background-color": "@borderColor"
              },
              "& when (@collapsed)": {
