                    "min-height": "140px !important"
                  },
                  "color": "@iconBg",
                  "background-color": "@iconHoverColor"
                }
              }
            },
            ".mbr-media span": {
              "font-size": "4rem",
              "transition": "all 0.2s"
            },
            ".modalWindow": {
