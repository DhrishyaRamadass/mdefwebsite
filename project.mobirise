        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-title": {
              "padding-top": "5.5%",
              "@media (max-width: 991px)": {
                "padding-top": "0"
              }
            },
            ".col-text": {
              "padding-top": "100px",
              "@media (min-width: 1200px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "110px !important"
                },
                "& when (@reverseContent)": {
                  "padding-right": "110px !important"
                }
              },
              "@media (max-width: 1199px)": {
                "padding-top": "70px"
              },
              "@media (max-width: 991px)": {
                "padding-top": "20px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "0",
              "color": "#fafafa"
            },
            ".mbr-section-subtitle": {
              "margin-top": "24px",
              "color": "#fafafa",
              "@media (max-width: 991px)": {
                "margin-top": "16px"
              }
            },
            ".mbr-text": {
              "color": "#131313"
            },
            ".mbr-section-btn": {
              "margin-top": "50px",
              "@media (max-width: 1199px)": {
                "margin-top": "14px"
              },
              ".btn-white": {
                "&:hover": {
                  "color": "@primaryColor !important"
                }
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#fafafa"
            }
          },
          "_name": "aheader3",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header3 calmm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#5189b8\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#a6d8b5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-title col-12 col-lg-6 flex-grow-1\" mbr-if=\"showTitle\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle || showSubtitle\">\n                    <b>The Best Way Home</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\">\n                    <b>A project on urban safety for women</b></h2>\n            </div>\n            <div class=\"col-text col-12 col-lg-6 flex-grow-1\" mbr-if=\"showText || showButtons\">\n                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    For this project, I have made a report detailing the intent, research and processes. Below I have included images of the graphics used in the intervention.</p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-white\" href=\"https://hackmd.io/@qHFexN_CS5q_u1TPYATfJA/thebestwayhome\" data-app-placeholder=\"Type Text\" target=\"_blank\">REPORT</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u8IppmgbqC",
          "_anchor": "aheader3-7v",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider01",
          "_sourceTheme": "energym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla energym5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" name=\"border\" title=\"Border Color\" value=\"#5189b8\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Card Icon\">\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#000000\" condition=\"showIcon\">\n        <input type=\"color\" name=\"iconBg\" title=\"Icon BG\" value=\"#FFF555\" condition=\"showIcon\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\">\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Card Description\">\n        <input type=\"color\" name=\"card\" title=\"Card BG\" value=\"#f5f5f5\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/energym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#5189b8\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-7\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                    Here are some common types of transportation\n                </h2>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            \n                            \n                            \n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <a href=\"#\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                            <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" mbr-if=\"showIcon\">\n                                            </span>\n                                                <img src=\"@PROJECT_PATH@/assets/images/a1-300-dpi-1000x1416.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                Consultation\n                                            </h4>\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\">\n                                                EV dealerships may provide consultation services\n                                            </p>\n                                        </div>\n                                    </a>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <a href=\"#\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                            <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" mbr-if=\"showIcon\">\n                                            </span>\n                                                <img src=\"@PROJECT_PATH@/assets/images/a1-300-dpi-1-1000x1416.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                Consultation\n                                            </h4>\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\">\n                                                EV dealerships may provide consultation services\n                                            </p>\n                                        </div>\n                                    </a>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <a href=\"#\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                            <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" mbr-if=\"showIcon\">\n                                            </span>\n                                                <img src=\"@PROJECT_PATH@/assets/images/a1-300-dpi-2-1000x1416.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                Consultation\n                                            </h4>\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\">\n                                                EV dealerships may provide consultation services\n                                            </p>\n                                        </div>\n                                    </a>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <a href=\"#\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                            <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" mbr-if=\"showIcon\">\n                                            </span>\n                                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2024-04-01-at-19.20.28-1000x1381.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                Consultation\n                                            </h4>\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\">\n                                                EV dealerships may provide consultation services\n                                            </p>\n                                        </div>\n                                    </a>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <a href=\"#\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                            <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" mbr-if=\"showIcon\">\n                                            </span>\n                                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2024-04-01-at-19.21.50-1000x1333.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                                            </div>\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                Consultation\n                                            </h4>\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc\">\n                                                EV dealerships may provide consultation services\n                                            </p>\n                                        </div>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 70px",
                "@media (max-width: 1440px)": {
                  "padding": "0 48px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "90px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              "color": "#000000"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "550px",
              "max-width": "550px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "a": {
                  "width": "100%",
                  "display": "inline-block",
                  "&:hover, &:focus": {
                    ".item-wrapper .item-img .mbr-iconfont": {
                      "transform": "scale(1)"
                    }
                  },
                  ".item-wrapper": {
                    ".item-img": {
                      "position": "relative",
                      "border-radius": "1.2rem",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "margin-bottom": "16px",
                      ".mbr-iconfont": {
                        "position": "absolute",
                        "top": "40px",
                        "right": "40px",
                        "width": "70px",
                        "height": "70px",
                        "font-size": "18px",
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "border-radius": "100%",
                        "color": "@icon",
                        "background-color": "@iconBg",
                        "transition": "all 0.3s ease-in-out",
                        "transform": "scale(0)"
                      },
                      "img": {
                        "height": "780px",
                        "border-radius": ".75rem !important",
                        "object-fit": "cover",
                        "@media (max-width: 992px)": {
                          "min-height": "400px"
                        }
                      }
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    ".card-title": {
                      "margin-bottom": "8px"
                    },
                    ".item-desc": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "25px",
              "height": "25px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent !important",
              "color": "@secondaryColor !important",
              "border": "none",
              "border-radius": "0",
              "transition": "all 0.3s ease-in-out",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": ".5 !important"
              },
              "&.embla__button--prev": {
                "right": "3rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "4rem",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "12px",
                  "left": "0",
                  "width": "90%",
                  "height": "1px",
                  "background-color": "@border",
                  "margin-right": "10rem",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                }
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem",
              "@media (max-width: 767px)": {
                "overflow": "hidden "
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-desc": {
              "color": "#9a9a9a"
            }
          },
          "_cid": "u8IrVTZM7Q",
          "_anchor": "slider01-7w",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
