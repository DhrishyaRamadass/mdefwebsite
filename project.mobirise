                "z-index": "5 !important",
                "padding-bottom": "10px"
              },
              ".border-item": {
                "position": "relative",
                "bottom": "0",
                "margin-top": "auto",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
