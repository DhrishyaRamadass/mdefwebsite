              "color": "#131313"
            },
            ".cards-row": {
              "margin-top": "5px",
              "row-gap": "30px"
            },
            ".card": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "stretch",
              "border-radius": "0"
            },
            ".card-wrapper": {
              "width": "~\"calc(100% - 14px)\"",
              "padding": "80px 40px 60px 40px",
              "margin": "0 auto",
              "border": "2px solid @cardBorder",
              "box-shadow": "4px 4px 0 @cardBorder",
              "background": "@cardBg",
              "transition": ".3s all",
              "@media (max-width: 1199px)": {
                "padding": "40px 30px"
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  "box-shadow": "none",
                  "transform": "translateY(-5px)"
                }
              }
            },
            ".iconfont-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 1199px)": {
                "margin-bottom": "25px"
              },
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "100px",
                "color": "@iconColor"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-text": {
              "margin-top": "10px",
              "color": "#131313"
            },
            ".card-link": {
              "margin-top": "30px",
              "color": "#131313",
              "@media (max-width: 1199px)": {
                "margin-top": "20px"
              },
              "@media (max-width: 767px)": {
