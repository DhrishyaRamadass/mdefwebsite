        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "70px",
              "@media (max-width: 1399px)": {
                "margin-bottom": "60px"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#131313"
            },
            ".mbr-section-subtitle": {
              "margin-top": "18px",
              "color": "#131313"
            },
            ".cards-row": {
              "margin-top": "5px",
              "row-gap": "30px"
            },
            ".card": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "stretch",
              "border-radius": "0"
            },
            ".card-wrapper": {
              "display": "flex",
              "width": "~\"calc(100% - 24px)\"",
              "padding": "52px 30px 52px 40px",
              "margin": "0 auto",
              "border": "2px solid @cardBorder",
              "box-shadow": "4px 4px 0 @cardBorder",
              "background": "@cardBg",
              "transition": ".3s all",
              "@media (max-width: 1199px)": {
                "padding": "40px 30px 40px 40px"
              },
              "@media (max-width: 991px)": {
                "padding": "30px"
              },
              "@media (max-width: 767px)": {
                "width": "~\"calc(100% - 14px)\"",
                "flex-direction": "column",
                "padding": "30px 25px 25px"
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  "box-shadow": "none",
                  "transform": "translateY(-5px)"
                }
              }
            },
            ".iconfont-wrapper": {
              "margin-right": "40px",
              "@media (max-width: 767px)": {
                "margin-right": "0",
                "margin-bottom": "15px"
              },
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "100px",
                "color": "@iconColor"
              }
            },
            ".content-wrap": {
              "margin-top": "10px",
              "@media (max-width: 1199px)": {
                "margin-top": "0"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-text": {
              "margin-top": "24px",
              "color": "#131313",
              "@media (max-width: 1199px)": {
                "margin-top": "15px"
              }
            },
            ".card-link": {
              "margin-top": "24px",
              "color": "#131313",
              "@media (max-width: 1199px)": {
                "margin-top": "20px"
              },
              "@media (max-width: 991px)": {
                "margin-top": "15px"
              },
              "a.text-primary": {
                "&:hover": {
                  "color": "#131313 !important"
                }
              }
            }
          },
          "_name": "afeatures5",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5 calmm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#FC7942\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\" checked>\n        <input type=\"color\" title=\"Card Bg\" name=\"cardBg\" value=\"#FFFFFF\">\n        <input type=\"color\" title=\"Card Border\" name=\"cardBorder\" value=\"#131313\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#d996a7\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 mbr-section-head\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b><br></b><br><b>The Master in Design for Emergent Futures</b></h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Suspendisse sed nisi lacus sed viverra tellus.\n                </h5>\n            </div>\n        </div>\n        <div class=\"row cards-row {{contentAlign}}\" mbr-if=\"showIcon  || showTitle || showText || showLink\">\n\n            <div class=\"card col-12 col-xl-6\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">\n                            <b>Term 1</b></h5>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Design Studio, Atlas of Weak Signals, Machine Paradox, Documenting Design, Living with your Ideas</p>\n                        <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\"><b><a href=\"term1.html\" class=\"text-danger text-primary\">GO TO PAGE</a></b></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-xl-6\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-image-slider mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">\n                            <b>Term 2</b></h5>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"></p>\n                        <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\"><b><a href=\"term2.html\" class=\"text-danger text-primary\">GO TO PAGE</a></b></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-xl-6\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-cursor-click mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">\n                            <b>Term 3</b></h5>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"></p>\n                        <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\"><b><a href=\"term3.html\" class=\"text-danger text-primary\" target=\"_blank\">GO TO PAGE</a></b></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-xl-6\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-features mobi-mbri\"></span>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\">\n                            <b>Masters Project</b></h5>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\"></p>\n                        <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\"><b><a href=\"mastersproject.html\" class=\"text-danger text-primary\" target=\"_blank\">GO TO PAGE</a></b></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tSU6yH2YKI",
          "_anchor": "afeatures5-22",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
