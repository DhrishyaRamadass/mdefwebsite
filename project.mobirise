              "& when (@showBorder)": {
                "height": "2px",
                "background-color": "@borderColor"
              },
              "& when (@collapsed)": {
                "display": "block"
              },
              "@media (max-width: 991px)": {
                "display": "block"
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "overflow": "hidden"
              },
              ".navbar.opened": {
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                }
              },
              ".navbar.navbar-short": {
