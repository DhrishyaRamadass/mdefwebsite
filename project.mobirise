          "_name": "afeatures3",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3 calmm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#48c0d2\" condition=\"showIcon && showList\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#b436b8\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-items-center justify-content-center\">\n            <div class=\"item-img\">\n                <img src=\"@PROJECT_PATH@/assets/images/screenshot-2024-03-03-at-05.46.11-1160x1178.png\" alt=\"Mobirise Website Builder\">\n            </div>\n            <div class=\"item-content\" mbr-if=\"showTitle || showList || showText || showButtons\">\n                <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                    <b>Examination</b></h5>\n                <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                    Descriptive list of items submitted for examination, including serial number, brand and model\n                </p>\n                <div class=\"list-box\" mbr-if=\"showList\">\n                    <div class=\"list-item\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Serial Number:&nbsp;</b><i>01 150929 1189</i></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 1\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Brand: </b><i>FUNDACIOCIM</i></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 2\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>MODEL:&nbsp;</b>BCN3D+ REPRAP2<br></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 3\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Weight: </b><i>11,6kg</i></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 4\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Colour: </b><i>BLACK/BLUE</i></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 5\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Made in (assembled): </b><i>SPAIN in 2015</i></p>\n                    </div>\n                </div>\n\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn btn-info\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                        GET STARTED\n                    </a></div>\n            </div>\n        </div>\n    </div>\n</section>",
