                "min-height": "400px",
                "padding": "50px 20px"
              },
              "@media (max-width: 767px)": {
                "padding": "50px 10px"
              }
            },
            ".mbr-section-title": {
              "color": "#131313"
            },
            ".mbr-section-subtitle": {
              "margin-top": "20px",
