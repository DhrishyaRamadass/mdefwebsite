p-placeholder=\"Type Text\" target=\"_blank\">Reflections</a><a class=\"dropdown-item text-black\" href=\"forensicreport.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Forensic Report</a><a class=\"dropdown-item text-black\" href=\"LifeX.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LifeX Project</a></div></div><a class=\"dropdown-item text-black\" href=\"livingwithyourideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Living with your Ideas</a><a class=\"dropdown-item text-black\" href=\"page25.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Documenting Design</a><a class=\"dropdown-item text-black\" href=\"biozero.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Biology Zero</a><a class=\"dropdown-item text-black\" href=\"agrizero.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Agriculture Zero</a><a class=\"dropdown-item text-black\" href=\"designwithothers.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design with Others</a><a class=\"dropdown-item text-black\" href=\"extendedintelligences.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design with Extended Intelligence</a><a class=\"dropdown-item text-black\" href=\"designdialogues.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Design Dialogues 1</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Term 2</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-228\"><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Design Studio 2<br></a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-770\"><a class=\"show dropdown-item text-black text-primary\" href=\"intervention1ds2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 1</a><a class=\"show dropdown-item text-black text-primary\" href=\"intervention2ds2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Intervention 2</a><a class=\"show dropdown-item text-black text-primary\" href=\"ds2reviews.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reviews</a><a class=\"show dropdown-item text-black text-primary\" href=\"ds2reflections.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reflection</a></div></div><a class=\"dropdown-item text-black text-primary show\" href=\"climateemergency.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Designing in a State of Climate Emergency</a><a class=\"dropdown-item text-black text-primary show\" href=\"futuretalksdd.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Future Talks: Distributed Design</a><a class=\"show dropdown-item text-black\" href=\"fairfutures.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Fair Futures</a><a class=\"show dropdown-item text-black text-primary\" href=\"measuringtheworld.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Measuring the World</a><a class=\"show dropdown-item text-black\" href=\"extendedintelligences2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Extended Intelligences</a><a class=\"show dropdown-item text-black text-primary\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">Communicating Ideas<br></a><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"digitalprototypingfordesign.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">Digital Prototyping for Design</a><div class=\"dropdown-menu dropdown-submenu\" aria-labelledby=\"dropdown-475\"><a class=\"show dropdown-item text-black text-primary\" href=\"biomaterials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">1: Biomaterials</a><a class=\"show dropdown-item text-black text-primary\" href=\"growingmaterials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">2: Growing and Extruding</a><a class=\"show dropdown-item text-black text-primary\" href=\"cncdpd.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">3: CNC</a></div></div><div class=\"dropdown\"><a class=\"dropdown-item text-black text-primary dropdown-toggle\" href=\"communicatingideas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-to