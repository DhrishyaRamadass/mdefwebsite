              },
              "& when (@collapsed)": {
                "display": "block"
              },
              "@media (max-width: 991px)": {
                "display": "block"
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "overflow": "hidden"
              },
              ".navbar.opened": {
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                }
              },
              ".navbar.navbar-short": {
                "background-color": "@menuBgColor !important"
              },
              ".navbar-collapse": {
                "position": "relative",
                "order": "5",
                "z-index": "5 !important",
                "padding-bottom": "10px"
              },
              ".border-item": {
                "position": "relative",
                "bottom": "0",
                "margin-top": "auto",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "top": "100%",
                  "left": "50%",
                  "transform": "translate(-50%, 0)",
                  "width": "100vw",
                  "height": "100vw",
                  "background": "@menuBgColor",
                  "z-index": "4",
