                }
              }
            },
            ".item-content": {
              "margin-top": "40px",
              "padding-left": "40px",
              "padding-right": "40px",
              "@media (max-width: 1199px)": {
                "margin-top": "20px",
                "padding-left": "20px",
                "padding-right": "20px"
              },
              "@media (max-width: 991px)": {
                "margin-top": "20px",
                "padding-left": "15px",
                "padding-right": "20px",
                "padding-bottom": "15px"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-text": {
              "margin-top": "5px",
              "color": "#131313"
            },
            ".link-text": {
              "margin-top": "20px",
              "color": "#FC7942",
              "@media (max-width: 1199px)": {
                "margin-top": "10px"
              },
              "@media (max-width: 767px)": {
                "margin-top": "5px"
