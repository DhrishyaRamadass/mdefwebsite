            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "margin": "0 !important",
              "row-gap": "30px",
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".item-img": {
              "display": "flex",
              "justify-content": "flex-start",
              "width": "50%",
              "padding": "0 !important",
              "& when (@reverseContent)": {
                "justify-content": "flex-end"
              },
              "img": {
                "max-width": "580px",
                "width": "100%",
                "object-fit": "cover"
              },
              "@media (max-width: 991px)": {
                "width": "100%"
              }
            },
            ".item-text": {
              "width": "50%",
              "padding": "0 !important",
              "@media (max-width: 1500px)": {
                "padding-left": "40px !important",
                "& when (@reverseContent)": {
                  "padding-left": "0 !important",
                  "padding-right": "40px !important"
                }
              },
              "@media (max-width: 1199px)": {
                "padding-left": "25px !important",
                "& when (@reverseContent)": {
                  "padding-left": "0 !important",
                  "padding-right": "25px !important"
                }
              },
              "@media (max-width: 991px)": {
                "width": "100%",
                "padding": "0 !important"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".content-box": {
              "display": "flex",
              "flex-direction": "column",
              "row-gap": "24px",
              "margin-top": "60px",
              "@media (max-width: 1399px)": {
                "margin-top": "40px"
              },
              "@media (max-width: 991px)": {
                "margin-top": "20px"
              }
            },
            ".content-item": {
              "width": "100%"
            },
            ".card-subtitle": {
              "color": "#131313",
              "a": {
                "pointer-events": "none"
              }
            },
            ".card-text": {
              "margin-top": "20px",
              "color": "#131313",
              "@media (max-width: 767px)": {
                "margin-top": "15px"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "30px",
              "@media (max-width: 1399px)": {
                "margin-top": "15px"
              }
            }
