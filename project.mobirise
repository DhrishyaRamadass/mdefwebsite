              "input, textarea": {
                "transition": ".3s all",
                "&:active, &:focus": {
                  "background-color": "transparent !important",
                  "border": "none !important",
                  "border-bottom": "2px solid @primaryColor !important",
                  "box-shadow": "none !important",
                  "outline": "none !important",
                  "&::-webkit-input-placeholder": {
