            ".col-text": {
              "padding-top": "100px",
              "@media (min-width: 1200px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "110px !important"
                },
                "& when (@reverseContent)": {
                  "padding-right": "110px !important"
                }
              },
              "@media (max-width: 1199px)": {
                "padding-top": "70px"
              },
              "@media (max-width: 991px)": {
                "padding-top": "20px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "0",
              "color": "#131313"
            },
            ".mbr-section-subtitle": {
              "margin-top": "24px",
              "color": "#131313",
              "@media (max-width: 991px)": {
                "margin-top": "16px"
              }
            },
            ".mbr-text": {
              "color": "#131313"
            },
            ".mbr-section-btn": {
              "margin-top": "50px",
              "@media (max-width: 1199px)": {
                "margin-top": "14px"
              },
              ".btn-white": {
                "&:hover": {
                  "color": "@primaryColor !important"
                }
              }
            }
